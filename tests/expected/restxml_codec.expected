Connection: close

<PutThingRequest xmlns="http://example.amazonaws.com/doc/2021-01-01/" version="2"><Name>gadget</Name><Owner><Id>o-1</Id></Owner><Tags><Tag>red</Tag><Tag>blue</Tag></Tags><Alias>a1</Alias><Alias>a2</Alias></PutThingRequest>
### rest-xml prefixed namespace + escaping ###
<ns:ChangeSet xmlns:ns="urn:aws:route53"><Comment>a &lt; b &amp; c &gt; d</Comment></ns:ChangeSet>
### rest-xml parse round-trip ###
Name=gadget
version=2
Owner.Id=o-1
tags=2:red,blue
alias=2:a1,a2
roundtrip-ok
### rest-xml error dispatch ###
code=NoSuchKey
message=The specified key does not exist.
status=404
code2=AccessDenied
message2=denied
status2=403
ok-no-error
